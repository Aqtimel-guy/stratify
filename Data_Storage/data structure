--- Table 6 ---
portfolios (
    protfolio_id
    user_id
    protfolio_name
    created_at (when the user open the protfolio)
    starting_at (at what time in history the protfolio started simulating)
    preferd_currency
    available_cash
    protfolio_value
    
)
